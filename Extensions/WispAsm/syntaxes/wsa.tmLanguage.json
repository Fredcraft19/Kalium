{
  "scopeName": "source.wsa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#label-reference" },
    { "include": "#label-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" }
  ],
  "repository": {
    "label-declaration": {
      "patterns": [{
        "match": "^\\s*([A-Za-z_][\\w.$]*(?:<[\\w.$,<>*]*>)?)(?=\\s*:)",
        "captures": {
          "1": { "name": "entity.name.function.wsa" }
        }
      }]
    },
    "label-reference": {
      "patterns": [{
        "match": "\\b(call|jump(?:-n?z)?)\\s+([A-Za-z_][\\w.$]*(?:<[\\w.$,<>*]*>)?)(?![\\w.$<>])",
        "captures": {
          "1": { "name": "keyword.control.wsa" },
          "2": { "name": "entity.name.function.wsa" }
        }
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.wsa",
        "match": "\\b(push|store[0-9]+[f*]?|load[a-z0-9]+|heap-store[a-z0-9]+|heap-load[a-z0-9]+|malloc|ref|free|call|ret|enter|jump(?:-n?z)?|add-[usf]|sub-[usf]|mul-[usf]|safe-div-[usf]|div-[usf]|[ne]ql-[usf]|gtr-[usf]|egtr-[usf]|les-[usf]|eles-[usf]|not|cast-[uf][fs]|printf|print|exit)(?![\\w*-])"
      }]
    },
    "constants": {
      "patterns": [{
        "name": "constant.numeric.wsa",
        "match": "\\b(0x[0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?[sf]?)\\b"
      }]
    },
    "comments": {
      "patterns": [{
        "name": "comment.line.number-sign.wsa",
        "match": "#.*$"
      }]
    }
  }
}
