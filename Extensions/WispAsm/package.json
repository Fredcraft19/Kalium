{
  "name": "wisp-assembly",
  "displayName": "Wisp Source Assembly",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "wsa",
      "aliases": ["Wisp Source Assembly", "WSA"],
      "extensions": [".wsa"],
      "syntax": "./wsa.tmLanguage.json"
    }],
    "grammars": [{
      "language": "wsa",
      "scopeName": "source.wsa",
      "path": "./syntaxes/wsa.tmLanguage.json"
    }]
  }
}
